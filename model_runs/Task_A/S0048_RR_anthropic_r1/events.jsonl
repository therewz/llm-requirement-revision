{"event":"tool_intent","previous_sha256":"cfa14fc5f29e33c871a126024a44e659e87b5d9dfeea7ee2f80976ce384905cd","seq":13,"sha256":"82580164b33c396292ddc398fd5f7055b609f679e01374230bb44b209902dae8","timestamp_utc":"2026-11-05T21:05:28.416951+00:00","tool_call":{"arguments":{"content":"from typing import List, Dict\nfrom datetime import datetime\n\n_DAY_ABBREVIATIONS = [\"mon\", \"tue\", \"wed\", \"thu\", \"fri\", \"sat\", \"sun\"]\n\n\ndef time_to_minutes(t: str) -> int:\n    try:\n        h, m = map(int, t.split(\":\"))\n        if not (0 <= h < 24 and 0 <= m < 60):\n            raise ValueError\n    except Exception:\n        raise ValueError(f\"Invalid time format: {t}\")\n    return h * 60 + m\n\ndef minutes_to_time(m: int) -> str:\n    h = m // 60\n    m = m % 60\n    return f\"{h:02d}:{m:02d}\"\n\ndef merge_intervals(intervals: List[List[int]]) -> List[List[int]]:\n    if not intervals:\n        return []\n    intervals.sort()\n    merged = [intervals[0]]\n    for current in intervals[1:]:\n        last = merged[-1]\n        if current[0] <= last[1]:\n            last[1] = max(last[1], current[1])\n        else:\n            merged.append(current)\n    return merged\n\ndef _is_friday(day: str) -> bool:\n    if not isinstance(day, str):\n        raise ValueError(f\"Invalid day: {day}\")\n    d = day.strip().lower()\n    if d in _DAY_ABBREVIATIONS:\n        return d == \"fri\"\n    # Also tolerate a full date for backward compatibility\n    try:\n        return datetime.strptime(day.strip(), \"%Y-%m-%d\").weekday() == 4\n    except Exception:\n        raise ValueError(f\"Invalid day: {day}\")\n\ndef suggest_slots(events: List[Dict[str, str]], meeting_duration: int, day: str) -> List[str]:\n    # Validate duration\n    if meeting_duration <= 0:\n        raise ValueError(\"Meeting duration must be greater than 0\")\n\n    is_friday = _is_friday(day)\n    WORK_START = 9 * 60\n    WORK_END = 17 * 60\n    LUNCH_START = 12 * 60\n    LUNCH_END = 13 * 60\n    BUFFER = 15\n    FRIDAY_LAST_START = 15 * 60\n\n    busy_intervals = []\n\n    for e in events:\n        try:\n            start = time_to_minutes(e['start'])\n            end = time_to_minutes(e['end'])\n        except KeyError:\n            raise ValueError(\"Event must have 'start' and 'end'\")\n        if start >= end:\n            raise ValueError(f\"Event start {e['start']} >= end {e['end']}\")\n        # Apply buffer and clamp to working hours\n        start = max(WORK_START, start - BUFFER)\n        end = min(WORK_END, end + BUFFER)\n        if start < end:\n            busy_intervals.append([start, end])\n\n    # Add lunch break\n    busy_intervals.append([LUNCH_START, LUNCH_END])\n\n    # Merge overlapping intervals\n    busy_intervals = merge_intervals(busy_intervals)\n\n    # Compute free intervals\n    free_intervals = []\n    prev_end = WORK_START\n    for start, end in busy_intervals:\n        if start > prev_end:\n            free_intervals.append([prev_end, start])\n        prev_end = max(prev_end, end)\n    if prev_end < WORK_END:\n        free_intervals.append([prev_end, WORK_END])\n\n    # Generate available start times\n    available_slots = []\n    for start, end in free_intervals:\n        slot_start = ((start + 14) // 15) * 15  # next 15-min increment\n        while slot_start + meeting_duration <= end:\n            # Fridays: meetings must not start after 15:00 (15:00 itself is allowed)\n            if not (is_friday and slot_start > FRIDAY_LAST_START):\n                available_slots.append(minutes_to_time(slot_start))\n            slot_start += 15\n\n    return available_slots\n","path":"src/solution.py"},"id":"toolu_01P21zdCt5989uwRSfSgN6ay","name":"write_file"},"tool_index":2,"turn":2}
