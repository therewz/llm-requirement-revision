{"event":"tool_intent","previous_sha256":"1c4f872516f8a5dbd4c27999d7e9d07f4bcc239beede93c134c19964ae42f157","seq":13,"sha256":"c1ed82f412807807bc8cc0df0259afee9aeeb766f6780cc1e2ac33347a0961aa","timestamp_utc":"2026-11-05T20:56:33.795096+00:00","tool_call":{"arguments":{"content":"from typing import List, Dict, Optional\n\nSLOT_STEP = 30\n\n# ----------------------------\n# Helpers\n# ----------------------------\n\ndef to_minutes(t: str) -> int:\n    try:\n        h, m = map(int, t.split(\":\"))\n        if not (0 <= h < 24) or not (0 <= m < 60):\n            raise ValueError\n        return h * 60 + m\n    except Exception:\n        raise ValueError(f\"Invalid time format: {t}\")\n\ndef to_time_str(m: int) -> str:\n    return f\"{m // 60:02d}:{m % 60:02d}\"\n\ndef merge_intervals(intervals: List[List[int]]) -> List[List[int]]:\n    if not intervals:\n        return []\n    intervals.sort()\n    merged = [intervals[0]]\n    for start, end in intervals[1:]:\n        last_end = merged[-1][1]\n        if start <= last_end:\n            merged[-1][1] = max(last_end, end)\n        else:\n            merged.append([start, end])\n    return merged\n\n# ----------------------------\n# Main function\n# ----------------------------\n\ndef suggest_slots(events: List[Dict[str, str]], meeting_duration: int, day: Optional[str] = None) -> List[str]:\n    if meeting_duration <= 0:\n        raise ValueError(\"Meeting duration must be positive.\")\n\n    WORK_START = to_minutes(\"09:00\")\n    WORK_END = to_minutes(\"17:00\")\n\n    intervals = []\n    for e in events or []:\n        start = to_minutes(e[\"start\"])\n        end = to_minutes(e[\"end\"])\n        if start >= end:\n            raise ValueError(f\"Event start time {e['start']} >= end time {e['end']}\")\n        start = max(start, WORK_START)\n        end = min(end, WORK_END)\n        if start < end:\n            intervals.append([start, end])\n\n    # Lunch break\n    intervals.append([to_minutes(\"12:00\"), to_minutes(\"13:00\")])\n\n    blocked = merge_intervals(intervals)\n\n    # Slots every 30 minutes, in ascending order\n    valid_slots = []\n    current = WORK_START\n    while current + meeting_duration <= WORK_END:\n        meeting_end = current + meeting_duration\n        conflict = any(not (meeting_end <= start or current >= end) for start, end in blocked)\n        if not conflict:\n            valid_slots.append(to_time_str(current))\n        current += SLOT_STEP\n\n    return valid_slots\n","path":"src/solution.py"},"id":"toolu_01Y4nGyUpDdKixQJr5T8Ckdo","name":"write_file"},"tool_index":2,"turn":2}
