{"event":"tool_intent","previous_sha256":"3c15f5e0248fe0a0154371df75c841ceafda4b9346ea1eee45faaa5e770d503d","seq":13,"sha256":"66208847a056321b28be6def152548655002a4d1338a72a9a2e0243a771df115","timestamp_utc":"2026-11-05T21:11:41.056307+00:00","tool_call":{"arguments":{"content":"from collections.abc import Mapping\nfrom typing import List, Dict\nfrom datetime import datetime\n\n\ndef time_to_minutes(t: str) -> int:\n    \"\"\"Convert 'HH:MM' string to minutes since midnight.\"\"\"\n    try:\n        h, m = map(int, t.split(\":\"))\n        if not (0 <= h <= 23 and 0 <= m <= 59):\n            raise ValueError\n    except Exception:\n        raise ValueError(f\"Invalid time format: {t}\")\n    return h * 60 + m\n\n\ndef minutes_to_time(m: int) -> str:\n    \"\"\"Convert minutes since midnight to 'HH:MM' string.\"\"\"\n    h, m = divmod(m, 60)\n    return f\"{h:02d}:{m:02d}\"\n\n\ndef validate_date(day: str):\n    \"\"\"Validate date string 'YYYY-MM-DD'.\"\"\"\n    try:\n        dt = datetime.strptime(day, \"%Y-%m-%d\")\n        return dt\n    except ValueError:\n        raise ValueError(f\"Invalid date: {day}\")\n\n\ndef suggest_slots(events: List[Dict[str, str]], meeting_duration: int, day: str) -> List[str]:\n    \"\"\"Print and return available starts on the 15-minute working-day grid.\n\n    Duration accepts an integer or an integer string. Events may specify an\n    explicit end; otherwise they last for the requested meeting duration.\n    The legacy ``day`` argument is retained, but availability does not depend\n    on the date or weekday. Lunch prevents starts, not meetings spanning it.\n    \"\"\"\n    if not isinstance(events, list):\n        raise ValueError(\"Events must be a list of mappings\")\n    if isinstance(meeting_duration, bool) or not isinstance(meeting_duration, (int, str)):\n        raise ValueError(\"Meeting duration must be a positive integer\")\n    try:\n        meeting_duration = int(meeting_duration)\n    except ValueError:\n        raise ValueError(\"Meeting duration must be a positive integer\")\n    if meeting_duration <= 0:\n        raise ValueError(\"Meeting duration must be positive\")\n\n    WORK_START = 9 * 60\n    WORK_END = 17 * 60\n    LUNCH_START = 12 * 60\n    LUNCH_END = 13 * 60\n    SLOT_GRANULARITY = 15\n\n    normalized_events = []\n    for ev in events:\n        if not isinstance(ev, Mapping) or \"start\" not in ev:\n            raise ValueError(\"Event must be a mapping with a start time\")\n        start = time_to_minutes(ev[\"start\"])\n        end = time_to_minutes(ev[\"end\"]) if \"end\" in ev else start + meeting_duration\n        if not WORK_START <= start < end <= WORK_END:\n            raise ValueError(f\"Event must be within working hours: {ev}\")\n        normalized_events.append((start, end))\n    normalized_events.sort()\n\n    slots = []\n    for current in range(WORK_START, WORK_END - meeting_duration + 1, SLOT_GRANULARITY):\n        if LUNCH_START <= current < LUNCH_END:\n            continue\n        # Half-open intervals permit a meeting directly before or after an event.\n        if any(current < end and current + meeting_duration > start\n               for start, end in normalized_events):\n            continue\n        slots.append(minutes_to_time(current))\n\n    print(slots)\n    return slots\n","path":"src/solution.py"},"id":"call_lJNj6NzOlo1lFriGrtZgNMAe","name":"write_file"},"tool_index":2,"turn":2}
