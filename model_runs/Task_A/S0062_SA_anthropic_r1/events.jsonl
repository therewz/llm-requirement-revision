{"event":"tool_intent","previous_sha256":"2e5a6324b082b196d1e72e1ad19d39163e23ee7a66699065bf0efa919686b197","seq":13,"sha256":"1c141dd64416dddcea6bc96452c957616f79448a9e98bff7be289582b0cb8f63","timestamp_utc":"2026-11-05T21:22:25.728315+00:00","tool_call":{"arguments":{"content":"from typing import List, Dict\nfrom datetime import datetime\n\n# -------------------------\n# Helper functions\n# -------------------------\ndef time_to_minutes(t: str) -> int:\n    try:\n        h, m = map(int, t.split(\":\"))\n    except Exception:\n        raise ValueError(f\"Invalid time format: {t}\")\n    if not (0 <= h < 24 and 0 <= m < 60):\n        raise ValueError(f\"Invalid time value: {t}\")\n    return h * 60 + m\n\ndef minutes_to_time(m: int) -> str:\n    h = m // 60\n    m = m % 60\n    return f\"{h:02d}:{m:02d}\"\n\ndef merge_intervals(intervals: List[List[int]]) -> List[List[int]]:\n    if not intervals:\n        return []\n    intervals.sort()\n    merged = [intervals[0]]\n    for start, end in intervals[1:]:\n        if start <= merged[-1][1]:\n            merged[-1][1] = max(end, merged[-1][1])\n        else:\n            merged.append([start, end])\n    return merged\n\ndef validate_date(day: str):\n    try:\n        datetime.strptime(day, \"%Y-%m-%d\")\n    except (ValueError, TypeError):\n        raise ValueError(f\"Invalid date: {day}\")\n\n# -------------------------\n# Main function\n# -------------------------\ndef suggest_slots(events: List[Dict[str, str]], meeting_duration: int, day: str) -> List[str]:\n    # Input validation\n    validate_date(day)\n    if isinstance(meeting_duration, bool) or not isinstance(meeting_duration, int):\n        raise ValueError(\"Meeting duration must be an integer\")\n    if meeting_duration <= 0:\n        raise ValueError(\"Meeting duration must be positive\")\n\n    WORK_START, WORK_END = 9 * 60, 17 * 60\n    LUNCH_START, LUNCH_END = 12 * 60, 13 * 60\n    SLOT_INTERVAL = 15\n\n    # Parse events (clamped to working hours; events outside are ignored)\n    busy_intervals = []\n    for e in events or []:\n        if 'start' not in e or 'end' not in e:\n            continue\n        start = time_to_minutes(e['start'])\n        end = time_to_minutes(e['end'])\n        if start >= end:\n            raise ValueError(f\"Event start must be before end: {e}\")\n        start = max(start, WORK_START)\n        end = min(end, WORK_END)\n        if start < end:\n            busy_intervals.append([start, end])\n\n    busy_intervals = merge_intervals(busy_intervals)\n\n    # Generate valid slots\n    valid_slots = []\n    candidate_start = WORK_START\n    while candidate_start + meeting_duration <= WORK_END:\n        candidate_end = candidate_start + meeting_duration\n        in_lunch = LUNCH_START <= candidate_start < LUNCH_END\n        overlap = any(candidate_start < b_end and candidate_end > b_start\n                      for b_start, b_end in busy_intervals)\n        if not in_lunch and not overlap:\n            valid_slots.append(minutes_to_time(candidate_start))\n        candidate_start += SLOT_INTERVAL\n\n    return valid_slots\n","path":"src/solution.py"},"id":"toolu_01CxH74heWgJWfjFRLkjq6Ym","name":"write_file"},"tool_index":2,"turn":2}
