{"event":"tool_intent","previous_sha256":"7ae00d2cbc05f32c6a469ca81ce4e64ca893e85ef93afbeaa423594cf7e35c3a","seq":13,"sha256":"bb45652f95bc6bf4d371f106e7c64e1f865f4de161d2c96fa58be000aeb39d7f","timestamp_utc":"2026-11-05T21:11:29.493778+00:00","tool_call":{"arguments":{"content":"from typing import List, Dict\nfrom datetime import datetime\n\nWORK_START = \"09:00\"\nWORK_END = \"17:00\"\n\n\ndef time_to_minutes(t: str) -> int:\n    try:\n        h, m = map(int, t.split(\":\"))\n        if not (0 <= h <= 23 and 0 <= m <= 59):\n            raise ValueError\n        return h * 60 + m\n    except Exception:\n        raise ValueError(f\"Invalid time format: {t}\")\n\n\ndef minutes_to_time(m: int) -> str:\n    return f\"{m // 60:02d}:{m % 60:02d}\"\n\n\ndef validate_event(event: Dict[str, str]):\n    if \"start\" not in event or \"end\" not in event:\n        raise ValueError(\"Event must have start and end times\")\n    start = time_to_minutes(event[\"start\"])\n    end = time_to_minutes(event[\"end\"])\n    if start >= end:\n        raise ValueError(f\"Event start {event['start']} must be before end {event['end']}\")\n\n\ndef suggest_slots(events: List[Dict[str, str]], meeting_duration: int, day: str) -> List[str]:\n    if (not isinstance(meeting_duration, int)\n            or isinstance(meeting_duration, bool)\n            or meeting_duration <= 0):\n        raise ValueError(\"Meeting duration must be a positive integer\")\n\n    try:\n        datetime.strptime(day, \"%Y-%m-%d\")\n    except Exception:\n        raise ValueError(f\"Invalid date: {day}\")\n\n    work_start = time_to_minutes(WORK_START)\n    work_end = time_to_minutes(WORK_END)\n\n    if meeting_duration > (work_end - work_start):\n        return []\n\n    # Normalize and merge events, including overlaps and back-to-back events.\n    busy_times = []\n    for event in events:\n        validate_event(event)\n        start = max(work_start, time_to_minutes(event[\"start\"]))\n        end = min(work_end, time_to_minutes(event[\"end\"]))\n        if start < end:\n            busy_times.append((start, end))\n\n    busy_times.sort()\n    merged = []\n    for start, end in busy_times:\n        if not merged or start > merged[-1][1]:\n            merged.append([start, end])\n        else:\n            merged[-1][1] = max(merged[-1][1], end)\n\n    # Enumerate every minute at which the entire meeting fits in a free gap.\n    slots = []\n    prev_end = work_start\n    for start, end in merged:\n        slots.extend(\n            minutes_to_time(slot_start)\n            for slot_start in range(prev_end, start - meeting_duration + 1)\n        )\n        prev_end = end\n\n    slots.extend(\n        minutes_to_time(slot_start)\n        for slot_start in range(prev_end, work_end - meeting_duration + 1)\n    )\n    return slots\n","path":"src/solution.py"},"id":"call_d9466c91f7474760819a53ab4d96054d","name":"write_file"},"tool_index":2,"turn":2}
