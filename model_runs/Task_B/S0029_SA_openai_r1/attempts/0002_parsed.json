, int) or math.isfinite(x))\\n    )\\n\\n\\ndef is_allocation_feasible(\\n    resources: Dict[str, Number],\\n    requests: List[Dict[str, Number]]\\n) -> bool:\\n    \\\"\\\"\\\"Return whether all requests fit within the available capacities.\\n\\n    Requests may be dictionaries or (resource_id, amount) tuples. Empty inputs\\n    and allocations that use all available capacity are allowed.\\n\\n    Raises:\\n        TypeError: If the input containers or request entries are malformed.\\n        ValueError: If a capacity or amount is not a finite, non-negative number.\\n\\n    A request for an unavailable resource makes the allocation infeasible.\\n    \\\"\\\"\\\"\\n    if not isinstance(resources, dict):\\n        raise TypeError(\\\"resources must be a dict mapping resource name to capacity\\\")\\n    if not isinstance(requests, list):\\n        raise TypeError(\\\"requests must be a list of request dicts or tuples\\\")\\n\\n    capacities = {}\\n    for name, cap in resources.items():\\n        if not _is_finite_number(cap):\\n            raise ValueError(f\\\"capacity for resource '{name}' must be a finite number\\\")\\n        if cap < 0:\\n            raise ValueError(f\\\"capacity for resource '{name}' must be non-negative\\\")\\n        capacities[name] = Fraction(cap)\\n\\n    # Exact sums prevent rounding from hiding an excess, including when large\\n    # integer capacities are combined with floating-point request amounts.\\n    totals = {name: Fraction(0) for name in capacities}\\n    all_resources_present = True\\n    for req in requests:\\n        if isinstance(req, dict):\\n            items = req.items()\\n        elif isinstance(req, tuple) and len(req) == 2:\\n            items = (req,)\\n        else:\\n            raise TypeError(\\\"each request must be a dict or a (resource_id, amount) tuple\\\")\\n\\n        for name, amount in items:\\n            if not _is_finite_number(amount):\\n                raise ValueError(f\\\"request amount for resource '{name}' must be a finite number\\\")\\n            if amount < 0:\\n                raise ValueError(f\\\"request amount for resource '{name}' must be non-negative\\\")\\n            if name not in capacities:\\n                all_resources_present = False\\n            else:\\n                totals[name] += Fraction(amount)\\n\\n    return all_resources_present and all(\\n        totals[name] <= capacity for name, capacity in capacities.items()\\n    )\\n\",\"path\":\"src/solution.py\"}","call_id":"call_Y4kdVcen7OaN5tEfjwm8H2LL","id":"fc_05c80c59e0371f2c016aecf6aadb2c87d29df48b102564d575","name":"write_file","status":"completed","type":"function_call"}],"model":"gpt-6.1-sol","response_id":"resp_05c80c59e0371f2c016aecf692378887d284a8bdbed6e8c77d","status":"tool_calls","text":"","tool_calls":[{"arguments":{"content":"from typing import Dict, List, Union\nfrom fractions import Fraction\nimport math\n\nNumber = Union[int, float]\n\n\ndef _is_finite_number(x: object) -> bool:\n    return (\n        isinstance(x, (int, float))\n        and not isinstance(x, bool)\n        and (isinstance(x, int) or math.isfinite(x))\n    )\n\n\ndef is_allocation_feasible(\n    resources: Dict[str, Number],\n    requests: List[Dict[str, Number]]\n) -> bool:\n    \"\"\"Return whether all requests fit within the available capacities.\n\n    Requests may be dictionaries or (resource_id, amount) tuples. Empty inputs\n    and allocations that use all available capacity are allowed.\n\n    Raises:\n        TypeError: If the input containers or request entries are malformed.\n        ValueError: If a capacity or amount is not a finite, non-negative number.\n\n    A request for an unavailable resource makes the allocation infeasible.\n    \"\"\"\n    if not isinstance(resources, dict):\n        raise TypeError(\"resources must be a dict mapping resource name to capacity\")\n    if not isinstance(requests, list):\n        raise TypeError(\"requests must be a list of request dicts or tuples\")\n\n    capacities = {}\n    for name, cap in resources.items():\n        if not _is_finite_number(cap):\n            raise ValueError(f\"capacity for resource '{name}' must be a finite number\")\n        if cap < 0:\n            raise ValueError(f\"capacity for resource '{name}' must be non-negative\")\n        capacities[name] = Fraction(cap)\n\n    # Exact sums prevent rounding from hiding an excess, including when large\n    # integer capacities are combined with floating-point request amounts.\n    totals = {name: Fraction(0) for name in capacities}\n    all_resources_present = True\n    for req in requests:\n        if isinstance(req, dict):\n            items = req.items()\n        elif isinstance(req, tuple) and len(req) == 2:\n            items = (req,)\n        else:\n            raise TypeError(\"each request must be a dict or a (resource_id, amount) tuple\")\n\n        for name, amount in items:\n            if not _is_finite_number(amount):\n                raise ValueError(f\"request amount for resource '{name}' must be a finite number\")\n            if amount < 0:\n                raise ValueError(f\"request amount for resource '{name}' must be non-negative\")\n            if name not in capacities:\n                all_resources_present = False\n            else:\n                totals[name] += Fraction(amount)\n\n    return all_resources_present and all(\n        totals[name] <= capacity for name, capacity in capacities.items()\n    )\n","path":"src/solution.py"},"id":"call_Y4kdVcen7OaN5tEfjwm8H2LL","name":"write_file"}],"usage":{"cache_read_input_tokens":0,"cache_write_input_tokens":1765,"input_tokens":1768,"output_tokens":1565}}
