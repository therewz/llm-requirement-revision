ed inputs.\\n    \\\"\\\"\\\"\\n    if not isinstance(resources, dict) or not isinstance(requests, list):\\n        return False\\n\\n    for resource_name, capacity in resources.items():\\n        if (\\n            not isinstance(resource_name, str)\\n            or not isinstance(capacity, (int, float))\\n            or not capacity >= 0\\n        ):\\n            return False\\n\\n    total_demand: Dict[str, Number] = {}\\n    for request in requests:\\n        if not isinstance(request, dict):\\n            return False\\n        for resource_name, amount in request.items():\\n            if (\\n                not isinstance(resource_name, str)\\n                or not isinstance(amount, (int, float))\\n                or not amount >= 0\\n            ):\\n                return False\\n            total_demand[resource_name] = total_demand.get(resource_name, 0) + amount\\n\\n    for resource_name, demand in total_demand.items():\\n        if resource_name not in resources or demand > resources[resource_name]:\\n            return False\\n\\n    return True\\n\",\"path\":\"src/solution.py\"}","call_id":"call_nzkPqkY9vkHcjMeBzIDfGHc0","id":"fc_098e2d14948668fb016aecf624769087d2b93c095d7224086c","name":"write_file","status":"completed","type":"function_call"}],"model":"gpt-6.1-sol","response_id":"resp_098e2d14948668fb016aecf614e26487d287765013c303b955","status":"tool_calls","text":"I’ll remove the leftover-capacity requirement and make invalid inputs and negative amounts return `False` instead of raising errors.","tool_calls":[{"arguments":{"content":"from typing import Dict, List, Union\n\nNumber = Union[int, float]\n\n\ndef is_allocation_feasible(\n    resources: Dict[str, Number],\n    requests: List[Dict[str, Number]]\n) -> bool:\n    \"\"\"\n    Determine whether all requests fit within the available resource capacities.\n\n    Args:\n        resources: Mapping from resource name to total available capacity.\n        requests: List of mappings from resource name to the amount required.\n\n    Returns:\n        True if every resource's total demand is within its capacity, including\n        when all available resources are consumed. False for infeasible\n        allocations, negative amounts, or malformed inputs.\n    \"\"\"\n    if not isinstance(resources, dict) or not isinstance(requests, list):\n        return False\n\n    for resource_name, capacity in resources.items():\n        if (\n            not isinstance(resource_name, str)\n            or not isinstance(capacity, (int, float))\n            or not capacity >= 0\n        ):\n            return False\n\n    total_demand: Dict[str, Number] = {}\n    for request in requests:\n        if not isinstance(request, dict):\n            return False\n        for resource_name, amount in request.items():\n            if (\n                not isinstance(resource_name, str)\n                or not isinstance(amount, (int, float))\n                or not amount >= 0\n            ):\n                return False\n            total_demand[resource_name] = total_demand.get(resource_name, 0) + amount\n\n    for resource_name, demand in total_demand.items():\n        if resource_name not in resources or demand > resources[resource_name]:\n            return False\n\n    return True\n","path":"src/solution.py"},"id":"call_nzkPqkY9vkHcjMeBzIDfGHc0","name":"write_file"}],"usage":{"cache_read_input_tokens":0,"cache_write_input_tokens":1430,"input_tokens":1433,"output_tokens":958}}
