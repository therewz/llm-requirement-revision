any(not isinstance(req, dict) for req in requests):\\n        raise ValueError(\\\"Each request must be a dictionary.\\\")\\n\\n    def is_nonnegative_number(value):\\n        if not isinstance(value, numbers.Number):\\n            return False\\n        try:\\n            return value >= 0\\n        except (TypeError, ValueError, ArithmeticError):\\n            # For example, complex numbers are not ordered, and NaN is not\\n            # non-negative (Decimal NaN can raise rather than compare false).\\n            return False\\n\\n    if any(not is_nonnegative_number(capacity) for capacity in resources.values()):\\n        return False\\n\\n    total_allocated = {res_name: 0 for res_name in resources}\\n    for req in requests:\\n        for res_name, amount in req.items():\\n            if res_name not in resources or not is_nonnegative_number(amount):\\n                return False\\n            total_allocated[res_name] += amount\\n            if total_allocated[res_name] > resources[res_name]:\\n                return False\\n\\n    return True\\n\",\"path\":\"src/solution.py\"}","call_id":"call_SfIqe2u4LHFWwuEve6ZRYHGP","id":"fc_0579d3dd46eccef2016aecf9a7c4b887d29431c712493ac1f3","name":"write_file","status":"completed","type":"function_call"}],"parallel_tool_calls":false,"presence_penalty":0.0,"previous_response_id":null,"prompt_cache_key":null,"prompt_cache_retention":"24h","reasoning":{"context":"all_turns","effort":"high","mode":"standard","summary":null},"safety_identifier":null,"service_tier":"default","status":"completed","store":false,"temperature":1.0,"text":{"format":{"type":"text"},"verbosity":"medium"},"tool_choice":"auto","tool_usage":{"image_gen":{"input_tokens":0,"input_tokens_details":{"image_tokens":0,"text_tokens":0},"output_tokens":0,"output_tokens_details":{"image_tokens":0,"text_tokens":0},"total_tokens":0},"web_search":{"num_requests":0}},"tools":[{"description":"Read a Python file in this workspace.","name":"read_file","output_schema":