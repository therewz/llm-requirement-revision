se.\\n\\n    Raises:\\n        ValueError: If inputs are not dictionaries/list of dictionaries with\\n            string keys and numeric values.\\n    \\\"\\\"\\\"\\n    if not isinstance(resources, dict):\\n        raise ValueError(\\\"Resources must be a dictionary\\\")\\n    if not isinstance(requests, list):\\n        raise ValueError(\\\"Requests must be a list\\\")\\n\\n    def validate_mapping(mapping):\\n        if not isinstance(mapping, dict):\\n            raise ValueError(\\\"Each request must be a dictionary\\\")\\n        for key, value in mapping.items():\\n            if not isinstance(key, str):\\n                raise ValueError(\\\"Resource names must be strings\\\")\\n            if isinstance(value, bool) or not isinstance(value, (Real, Decimal)):\\n                raise ValueError(\\\"Resource and request values must be numbers\\\")\\n\\n    # Validate the entire input format before checking allocation feasibility.\\n    validate_mapping(resources)\\n    for request in requests:\\n        validate_mapping(request)\\n\\n    def exact_amount(value):\\n        try:\\n            # Treat floats as decimal quantities, avoiding rounding artifacts\\n            # such as 0.1 + 0.2 incorrectly exceeding a capacity of 0.3.\\n            return Fraction(str(value)) if isinstance(value, float) else Fraction(value)\\n        except (ValueError, OverflowError):\\n            # NaN and infinity are numeric, but are not valid capacities/requests.\\n            return None\\n\\n    valid_names = {\\\"cpu\\\", \\\"ram\\\", \\\"mem\\\"}\\n    capacities = {}\\n    for key, value in resources.items():\\n        capacity = exact_amount(value)\\n        if key not in valid_names or capacity is None or capacity <= 0:\\n            return False\\n        capacities[key] = capacity\\n\\n    usage = {key: Fraction(0) for key in capacities}\\n    for request in requests:\\n        for key, value in request.items():\\n            if key not in capacities:\\n                return False\\n            amount = exact_amount(value)\\n            if amount is None:\\n                return False\\n            usage[key] += amount\\n\\n    # Signed requests can offset one another, so check final totals rather\\n    # than rejecting an intermediate total that exceeds capacity.\\n    if any(usage[key] > capacity for key, capacity in capacities.items()):\\n        return False\\n\\n    # An empty resource mapping or an allocation consuming every capacity\\n    # cannot leave any resource capacity unallocated.\\n    return any(usage[key] < capacity for key, capacity in capacities.items())\\n\",\"path\":\"src/solution.py\"}","call_id":"call_qOgv5zOfVvVJUesVPomHSO2t","id":"fc_09b0a09ea91a1174016aecf7a69c4087d28d0b6fd7f0a3a02b","name":"write_file","status":"completed","type":"function_call"}],"parallel_tool_calls":false,"presence_penalty":0.0,"previous_response_id":null,"prompt_cache_key":null,"prompt_cache_retention":"24h","reasoning":{"context":"all_turns","effort":"high","mode":"standard","summary":null},"safety_identifier":null,"service_tier":"default","status":"completed","store":false,"temperature":1.0,"text":{"format":{"type":"text"},"verbosity":"medium"},"tool_choice":"auto","tool_usage":{"image_gen":{"input_tokens":0,"input_tokens_details":{"image_tokens":0,"text_tokens":0},"output_tokens":0,"output_tokens_details":{"image_tokens":0,"text_tokens":0},"total_tokens":0},"web_search":{"num_requests":0}},"tools":[{"description":"Read a Python file in this workspace.","name":"read_file","output_schema":null,"parameters":{"additionalProperties":false,"properties":{"path":{"type":"string"}},"required":["path"],"type":"object"},"strict":true,"type":"function"},{"description":"Replace src/solution.py or create/replace a Python check under checks/.","name":"write_file","output_schema":null,"parameters":{"additionalProperties":false,"properties":{"content":{"type":"string"},"path":{"type":"string"}},"required":["path","content"],"type":"object"},