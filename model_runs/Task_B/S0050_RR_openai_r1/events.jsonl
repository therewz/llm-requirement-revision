{"event":"tool_intent","previous_sha256":"a9de2e0492f414c15e4186773a5d516a311b2306eb462fe70e781d1ac0b52b44","seq":20,"sha256":"e9d266c0562eef214f5f9da5a66f74e630f6bcf01737f161b05b1b7dc9ba4069","timestamp_utc":"2026-11-05T21:44:15.739635+00:00","tool_call":{"arguments":{"content":"\"\"\"Regression checks for resource allocation feasibility.\"\"\"\n\nimport importlib.util\nfrom itertools import product\nfrom pathlib import Path\n\nspec = importlib.util.spec_from_file_location(\n    \"solution\", Path(__file__).resolve().parents[1] / \"src\" / \"solution.py\"\n)\nmodule = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(module)\nfeasible = module.is_allocation_feasible\n\ncases = [\n    ({\"cpu\": 3}, [{\"cpu\": 2}], True),\n    ({\"cpu\": 3}, [{\"cpu\": 3}], False),\n    ({\"cpu\": 3}, [{\"cpu\": 4}], False),\n    ({\"cpu\": 3}, [{\"cpu\": 2}, {\"cpu\": 2}], False),\n    ({\"cpu\": 3}, [{\"cpu\": 1}, {\"cpu\": 1}], True),\n    ({\"cpu\": 3, \"gpu\": 1}, [{\"cpu\": 3}], True),\n    ({\"cpu\": 3, \"gpu\": 1}, [{\"cpu\": 3, \"gpu\": 1}], False),\n    ({\"cpu\": 3, \"gpu\": 1}, [{\"cpu\": 4}], False),\n    ({\"cpu\": 1}, [], True),\n    ({\"cpu\": 1}, [{\"cpu\": 0}], True),\n    ({}, [], False),\n    ({\"cpu\": 0}, [], False),\n    ({\"cpu\": 0}, [{\"cpu\": 0}], False),\n    ({\"cpu\": 1}, [{\"gpu\": 0}], False),\n    ({\"cpu\": 1}, [{\"cpu\": -1}], False),\n    ({\"cpu\": -1}, [], False),\n    ({\"cpu\": 1.0}, [], False),\n    ({\"cpu\": 1}, [{\"cpu\": 0.0}], False),\n    ({\"cpu\": True}, [], False),\n    ({\"cpu\": 2}, [{\"cpu\": True}], False),\n    ({\"cpu\": \"2\"}, [], False),\n    ({\"cpu\": 2}, [{\"cpu\": \"1\"}], False),\n    ({\"cpu\": 70}, [{\"cpu\": 69}], True),\n    ({\"cpu\": 71}, [], False),\n    ({\"cpu\": 35, \"gpu\": 35}, [], True),\n    ({\"cpu\": 36, \"gpu\": 35}, [], False),\n]\nfor resources, requests, expected in cases:\n    original_resources = dict(resources)\n    original_requests = [dict(request) for request in requests]\n    actual = feasible(resources, requests)\n    assert actual is expected, (resources, requests, expected, actual)\n    assert resources == original_resources\n    assert requests == original_requests\n\n# Exhaustively cover small capacities and two competing software units.\nfor cpu, gpu, a, b, c, d in product(range(4), repeat=6):\n    expected = (\n        a + c <= cpu\n        and b + d <= gpu\n        and a + b + c + d < cpu + gpu\n    )\n    assert feasible(\n        {\"cpu\": cpu, \"gpu\": gpu},\n        [{\"cpu\": a, \"gpu\": b}, {\"cpu\": c, \"gpu\": d}],\n    ) is expected\n\nprint(f\"Passed {len(cases)} regression cases and 4096 exhaustive cases.\")\n","path":"checks/check_solution.py"},"id":"call_Q1fLxwDrqJdaUEkckLuMhAWA","name":"write_file"},"tool_index":3,"turn":3}
