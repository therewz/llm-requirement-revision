n False\\n        if capacity < 0:\\n            return False\\n        total_capacity += capacity\\n\\n    if total_capacity > 70:\\n        return False\\n\\n    # Accumulate demand so that separate requests cannot share units.\\n    total_requested: Dict[str, Number] = {r: 0 for r in resources}\\n\\n    for request in requests:\\n        for resource, amount in request.items():\\n            if resource not in resources:\\n                return False\\n            if not isinstance(amount, int) or isinstance(amount, bool):\\n                return False\\n            if amount < 0:\\n                return False\\n\\n            total_requested[resource] += amount\\n            if total_requested[resource] > resources[resource]:\\n                return False\\n\\n    return sum(total_requested.values()) < total_capacity\\n\",\"path\":\"src/solution.py\"}","call_id":"call_7H0EFsoYwNZYmJdhxoTwZSy5","id":"fc_06e1291083094209016aecf8a2aaf887d28a1d65754cc8a065","name":"write_file","status":"completed","type":"function_call"}],"model":"gpt-6.1-sol","response_id":"resp_06e1291083094209016aecf892486c87d28ce1daeddef3a531","status":"tool_calls","text":"","tool_calls":[{"arguments":{"content":"\"\"\"Determine whether resource requests can be fully allocated.\"\"\"\n\nfrom typing import Dict, List, Union\n\nNumber = Union[int, float]\n\n\ndef is_allocation_feasible(\n    resources: Dict[str, Number],\n    requests: List[Dict[str, Number]]\n) -> bool:\n    \"\"\"Return whether all requests can be met with capacity left over.\n\n    Capacities and requested amounts must be nonnegative integers (not\n    booleans). There may be at most 70 resource units in total. Requests\n    must name existing resources, and their combined demand cannot exceed\n    any resource's capacity. At least one unit, across all resource types,\n    must remain unallocated, even when there are no requests.\n    \"\"\"\n    total_capacity = 0\n    for capacity in resources.values():\n        if not isinstance(capacity, int) or isinstance(capacity, bool):\n            return False\n        if capacity < 0:\n            return False\n        total_capacity += capacity\n\n    if total_capacity > 70:\n        return False\n\n    # Accumulate demand so that separate requests cannot share units.\n    total_requested: Dict[str, Number] = {r: 0 for r in resources}\n\n    for request in requests:\n        for resource, amount in request.items():\n            if resource not in resources:\n                return False\n            if not isinstance(amount, int) or isinstance(amount, bool):\n                return False\n            if amount < 0:\n                return False\n\n            total_requested[resource] += amount\n            if total_requested[resource] > resources[resource]:\n                return False\n\n    return sum(total_requested.values()) < total_capacity\n","path":"src/solution.py"},"id":"call_7H0EFsoYwNZYmJdhxoTwZSy5","name":"write_file"}],"usage":{"cache_read_input_tokens":1083,"cache_write_input_tokens":475,"input_tokens":1561,"output_tokens":999}}
