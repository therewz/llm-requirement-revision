":\"from fractions import Fraction\\nfrom typing import Dict, List, Union\\n\\nNumber = Union[int, float]\\n\\n\\ndef is_allocation_feasible(\\n    resources: Dict[str, Number],\\n    requests: List[Dict[str, Number]]\\n) -> bool:\\n    \\\"\\\"\\\"\\n    Determine whether all requests fit within the available resource capacities.\\n\\n    Each request maps resource names to non-negative int or float amounts.\\n    Return False for invalid inputs, unknown resources, or exceeded capacities.\\n    Resources may be fully consumed, and an empty set of requests is feasible.\\n    \\\"\\\"\\\"\\n    if not isinstance(resources, dict) or not isinstance(requests, list):\\n        return False\\n\\n    for key, value in resources.items():\\n        if not isinstance(key, str):\\n            return False\\n        if not isinstance(value, (int, float)) or not value >= 0:\\n            return False\\n\\n    # Exact totals avoid floating-point accumulation depending on request order.\\n    used = {resource: Fraction(0) for resource in resources}\\n    infinity = float(\\\"inf\\\")\\n\\n    for request in requests:\\n        if not isinstance(request, dict):\\n            return False\\n\\n        for key, value in request.items():\\n            if not isinstance(key, str) or key not in resources:\\n                return False\\n            if not isinstance(value, (int, float)) or not value >= 0:\\n                return False\\n\\n            # A non-negative numeric amount always fits an unlimited capacity.\\n            if resources[key] == infinity:\\n                continue\\n            if value == infinity:\\n                return False\\n\\n            used[key] += Fraction(value)\\n            if used[key] > resources[key]:\\n                return False\\n\\n    return True\\n\",\"path\":\"src/solution.py\"}","call_id":"call_GlYWZ4rFgnegQzjzHtCWc0AK","id":"fc_07387aefc29d30c0016aecf7547cc087d28fa087a446034a50","name":"write_file","status":"completed","type":"function_call"}],"model":"gpt-6.1-sol","response_id":"resp_07387aefc29d30c0016aecf742e3a487d2bf94b151183c3d5a","status":"tool_calls","text":"","tool_calls":[{"arguments":{"content":"from fractions import Fraction\nfrom typing import Dict, List, Union\n\nNumber = Union[int, float]\n\n\ndef is_allocation_feasible(\n    resources: Dict[str, Number],\n    requests: List[Dict[str, Number]]\n) -> bool:\n    \"\"\"\n    Determine whether all requests fit within the available resource capacities.\n\n    Each request maps resource names to non-negative int or float amounts.\n    Return False for invalid inputs, unknown resources, or exceeded capacities.\n    Resources may be fully consumed, and an empty set of requests is feasible.\n    \"\"\"\n    if not isinstance(resources, dict) or not isinstance(requests, list):\n        return False\n\n    for key, value in resources.items():\n        if not isinstance(key, str):\n            return False\n        if not isinstance(value, (int, float)) or not value >= 0:\n            return False\n\n    # Exact totals avoid floating-point accumulation depending on request order.\n    used = {resource: Fraction(0) for resource in resources}\n    infinity = float(\"inf\")\n\n    for request in requests:\n        if not isinstance(request, dict):\n            return False\n\n        for key, value in request.items():\n            if not isinstance(key, str) or key not in resources:\n                return False\n            if not isinstance(value, (int, float)) or not value >= 0:\n                return False\n\n            # A non-negative numeric amount always fits an unlimited capacity.\n            if resources[key] == infinity:\n                continue\n            if value == infinity:\n                return False\n\n            used[key] += Fraction(value)\n            if used[key] > resources[key]:\n                return False\n\n    return True\n","path":"src/solution.py"},"id":"call_GlYWZ4rFgnegQzjzHtCWc0AK","name":"write_file"}],"usage":{"cache_read_input_tokens":0,"cache_write_input_tokens":1758,"input_tokens":1761,"output_tokens":1064}}
