{"event":"tool_intent","previous_sha256":"7768b692685c99448c2bed5e27bfbf1c6a9bf5ea3b297a8596341682b18b34d1","seq":13,"sha256":"53bf45716937db7499bd79c02ef80ff60a3d5c5101b4b6bff0ee07d5a4a902a2","timestamp_utc":"2026-11-05T21:40:53.353440+00:00","tool_call":{"arguments":{"content":"from typing import Dict, List, Union\nfrom numbers import Number as Numeric\n\nNumber = Union[int, float]\n\n\ndef is_allocation_feasible(\n    resources: Dict[str, Number],\n    requests: List[Dict[str, Number]]\n) -> bool:\n    \"\"\"\n    Determine whether all resource demands fit within their independent capacities.\n\n    Args:\n        resources: Mapping from resource name to total available capacity.\n        requests: List of mappings from resource name to amount required.\n\n    Returns:\n        True if every requested resource exists and its total demand does not\n        exceed its capacity, False otherwise.\n\n    Raises:\n        TypeError: If input containers, keys, or numeric values have invalid types.\n        ValueError: If a request is not a dictionary or an amount is not non-negative.\n    \"\"\"\n    # Basic type checks\n    if not isinstance(resources, dict):\n        raise TypeError(\"Resources must be a dictionary.\")\n    if not isinstance(requests, list):\n        raise TypeError(\"Requests must be a list.\")\n\n    # Validate resources\n    for key, value in resources.items():\n        if not isinstance(key, str):\n            raise TypeError(\"Resource keys must be strings.\")\n        if not isinstance(value, Numeric):\n            raise TypeError(f\"Resource value for '{key}' must be a number.\")\n        if not value >= 0:\n            raise ValueError(f\"Resource value for '{key}' must be non-negative.\")\n\n    # Validate all requests before evaluating feasibility.\n    for request in requests:\n        if not isinstance(request, dict):\n            raise ValueError(\"Each request must be a dictionary.\")\n        for key, value in request.items():\n            if not isinstance(key, str):\n                raise TypeError(\"Request keys must be strings.\")\n            if not isinstance(value, Numeric):\n                raise TypeError(f\"Request value for '{key}' must be a number.\")\n            if not value >= 0:\n                raise ValueError(f\"Request value for '{key}' must be non-negative.\")\n\n    # Calculate total demand for each resource.\n    total_demand = {key: 0 for key in resources}\n    for request in requests:\n        for key, value in request.items():\n            if key not in resources:\n                return False\n            total_demand[key] += value\n\n    return all(demand <= resources[key] for key, demand in total_demand.items())\n","path":"src/solution.py"},"id":"call_9nPQi39YqzjActnzCRCcoPPf","name":"write_file"},"tool_index":2,"turn":2}
